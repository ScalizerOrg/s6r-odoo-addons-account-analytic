<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_manual_distribution" model="ir.ui.view">
        <field name="name">hr.employee.form.manual.distribution</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']/group/group[@name='active_group']" position="inside">
                <field name="manual_distribution_id"/>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_public_view_form_manual_distribution" model="ir.ui.view">
        <field name="name">hr.employee.public.form.manual.distribution</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='public']//group[@name='location']" position="after">
                <group name="analytic" string="Analytic Accounting"
                       invisible="not manual_distribution_id">
                    <field name="manual_distribution_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
